# Copy to .env or .env.local and fill your TMDB token
TMDB_ACCESS_TOKEN=

# Supabase Postgres connection string (Project Settings -> Database -> Connection string)
SUPABASE_CONNECTION_STRING=
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# JWT secret for access/refresh tokens (generate a long random string)
AUTH_JWT_SECRET=

# Auth settings (optional)
AUTH_JWT_ISSUER=dropdate
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_COOKIE_NAME=dd_refresh
AUTH_COOKIE_SECURE=false

# HTTP safety limits
HTTP_MAX_BODY_BYTES=1048576
HTTP_RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=20
EXPENSIVE_RATE_LIMIT_PER_MINUTE=30
SUPERUSER_EMAILS=

# Required for /jobs/* endpoints
JOBS_ACCESS_TOKEN=

# Email verification
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_VERIFICATION_TTL=24h
AUTH_VERIFICATION_RESEND_COOLDOWN=2m
AUTH_VERIFY_BASE_URL=
APP_BASE_URL=
RESEND_API_KEY=
RESEND_SENDER=
