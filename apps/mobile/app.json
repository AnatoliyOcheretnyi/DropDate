{
  "expo": {
    "name": "DropDate",
    "slug": "DropDate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dropdate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.poets-tololo.DropDate",
      "associatedDomains": ["applinks:drop-date.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070C13",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.poets_tololo.DropDate",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "drop-date.com",
              "pathPrefix": "/shared/"
            },
            {
              "scheme": "https",
              "host": "drop-date.com",
              "pathPrefix": "/title/"
            },
            {
              "scheme": "https",
              "host": "drop-date.com",
              "pathPrefix": "/person/"
            },
            {
              "scheme": "https",
              "host": "drop-date.com",
              "pathPrefix": "/auth/verify"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f7f8fa",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0b0f14"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
