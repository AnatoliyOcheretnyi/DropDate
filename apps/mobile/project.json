{
  "name": "mobile",
  "root": "apps/mobile",
  "sourceRoot": "apps/mobile/src",
  "projectType": "application",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo start",
        "cwd": "apps/mobile"
      }
    },
    "android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/mobile-native.sh android"
      }
    },
    "ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/mobile-native.sh ios"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo lint",
        "cwd": "apps/mobile"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/generate-routes.cjs && yarn typecheck",
        "cwd": "apps/mobile"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn format:check:mobile"
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "npx expo export --platform all --max-workers 2",
        "cwd": "apps/mobile"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test tests/*.test.cjs",
        "cwd": "apps/mobile"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo start --web --port 8082 --clear",
        "cwd": "apps/mobile"
      }
    },
    "android-build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx expo prebuild --platform android --no-install",
          "cd android && ./gradlew app:assembleDebug"
        ],
        "parallel": false,
        "cwd": "apps/mobile",
        "env": { "NODE_ENV": "development" }
      }
    }
  },
  "tags": []
}
