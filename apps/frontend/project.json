{
  "name": "frontend",
  "root": "apps/frontend",
  "sourceRoot": "apps/frontend/app",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn dev",
        "cwd": "apps/frontend"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.next", "{projectRoot}/out"],
      "options": {
        "command": "yarn build",
        "cwd": "apps/frontend"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn lint",
        "cwd": "apps/frontend"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn typecheck",
        "cwd": "apps/frontend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "command": "yarn test",
        "cwd": "apps/frontend"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/playwright-report", "{projectRoot}/test-results"],
      "options": {
        "command": "yarn e2e",
        "cwd": "apps/frontend"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn start",
        "cwd": "apps/frontend"
      },
      "dependsOn": ["build"]
    }
  },
  "tags": []
}
